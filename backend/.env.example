# --- База данных ---
DATABASE_URL=postgresql+psycopg://review:review@localhost:5432/review

# --- GitLab (self-hosted) ---
GITLAB_URL=https://gitlab.example.local
GITLAB_TOKEN=
# true / false / путь к CA-бандлу внутреннего центра сертификации
GITLAB_VERIFY_SSL=true
# true — вместо реального GitLab используется демо-MR из app/fixtures (для локальной разработки)
GITLAB_MOCK=true
# Проект, все MR которого импортируются на платформу (group/subgroup/project)
GITLAB_PROJECT=
# Какие MR импортировать: opened / merged / closed / all
GITLAB_MR_STATE=all

# --- Портал ТЗ ---
# stub — заглушка, данные из app/fixtures/tz_stub.json; http — реальный API (когда появится)
TZ_PORTAL_MODE=stub
TZ_PORTAL_URL=
TZ_PORTAL_TOKEN=

# --- Модель ---
# stub — заглушка без реальных вызовов; openai — OpenAI-совместимый endpoint (vLLM / TGI с Qwen)
LLM_MODE=stub
LLM_API_URL=http://localhost:8000/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=qwen
LLM_TIMEOUT=180
# Бюджет токенов на один запрос к модели (вход). Если изменений больше — режем на несколько запросов.
LLM_MAX_INPUT_TOKENS=6000
# Строк контекста вокруг значимых изменений
LLM_CONTEXT_LINES=2

# --- Связка с тикетом ---
TICKET_REGEX=[A-Z][A-Z0-9]+-\d+

# --- Файлы ---
# Расширения файлов, которые проверяются линтером и отправляются модели
CODE_EXTENSIONS=.plp
# Файлы, которые не считаются «лишними» при сверке с ТЗ (glob, через запятую)
TZ_IGNORE_PATTERNS=*.md,.gitlab-ci.yml,.gitignore
# Отключённые правила линтера, через запятую (например PLP003,PLP017)
LINT_DISABLED_RULES=
LINT_MAX_LINE_LENGTH=150

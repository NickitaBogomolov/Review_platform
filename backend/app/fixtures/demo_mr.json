      "change_type": "modified",
      "old": [
        "-- Операция: Пересчёт комиссии по счёту",
        "-- ТБП: AC_FIN",
        "PUBLIC",
        "procedure RECALC_COMM(P_DATE date, P_SUM number) is",
        "\tl_rate  number;",
        "\tl_comm  number;",
        "\tl_min   number;",
        "begin",
        "\tselect t(t.[RATE] : c_rate, t.[MIN_SUM] : c_min)",
        "\t  in ::[TARIFF] all",
        "\t where t.[CODE] = 'COMM_ACC'",
        "\t   and t.[DATE_BEG] <= P_DATE",
        "\t  into l_rate, l_min;",
        "",
        "\tl_comm := round(P_SUM * l_rate / 100, 2);",
        "\tif l_comm < l_min then",
        "\t\tl_comm := l_min;",
        "\tend if;",
        "",
        "\t[COMM_SUM] := l_comm;",
        "\t[COMM_DATE] := P_DATE;",
        "exception",
        "\twhen NO_DATA_FOUND then",
        "\t\tpragma error('Не найден тариф COMM_ACC на дату ' || to_char(P_DATE, 'dd.mm.yyyy'));",
        "end;",
        "",
        "PRIVATE",
        "function GET_CURRENCY return varchar2 is",
        "begin",
        "\treturn [ACCOUNT].[CURRENCY].[CODE_ISO];",
        "end;"
      ],
      "new": [
        "-- Операция: Пересчёт комиссии по счёту",
        "-- ТБП: AC_FIN",
        "PUBLIC",
        "procedure RECALC_COMM(P_DATE date, P_SUM number, P_CURRENCY varchar2 default null) is",
        "\tl_rate  number;",
        "\tl_comm  number;",
        "\tl_min   number;",
        "\tl_max   number;",
        "begin",
        "\tselect t(t.[RATE] : c_rate, t.[MIN_SUM] : c_min, t.[MAX_SUM] : c_max)",
        "\t  in ::[TARIFF] all",
        "\t where t.[CODE] = 'COMM_ACC'",
        "\t   and t.[DATE_BEG] <= P_DATE",
        "\t   and (t.[DATE_END] is null or t.[DATE_END] >= P_DATE)",
        "\t  into l_rate, l_min, l_max;",
        "",
        "\tdebug_pipe('RECALC_COMM: rate=' || l_rate, 0);",
        "\tl_comm := round(P_SUM * l_rate / 100, 2);",
        "\tif l_comm < l_min then",
        "\t\tl_comm := l_min;",
        "\tend if;",
        "\tif l_max = null then",
        "\t\tl_max := 999999999999;",
        "\tend if;",
        "\tif l_comm > l_max then",
        "\t\tl_comm := l_max;",
        "\tend if;",
        "",
        "\t[COMM_SUM]  := l_comm;",
        "\t[COMM_DATE] := P_DATE;",
        "\t-- [COMM_CUR] := GET_CURRENCY;",
        "exception",
        "\twhen NO_DATA_FOUND then",
        "\t\tpragma error('Не найден тариф COMM_ACC на дату ' || to_char(P_DATE, 'dd.mm.yyyy'));",
        "\twhen others then null;",
        "end;",
        "",
        "PRIVATE",
        "function GET_CURRENCY return varchar2 is",
        "begin",
        "\treturn [ACCOUNT].[CURRENCY].[CODE_ISO];",
        "end;"
      ]
    },
    {
      "old_path": "src/AC_FIN/CALC_PENALTY.plp",
      "new_path": "src/AC_FIN/CALC_PENALTY.plp",
      "change_type": "added",
      "old": [],
      "new": [
        "-- Операция: Расчёт пени по просроченной задолженности",
        "-- ТБП: AC_FIN",
        "PUBLIC",
        "procedure CALC_PENALTY(P_DATE date) is",
        "\tl_days  number;",
        "\tl_sum   number := 0;",
        "begin",
        "\tfor (select d(d : c_ref, d.[SUM] : c_sum, d.[DATE_PAY] : c_date)",
        "\t       in ::[DEBT] all",
        "\t      where d.[ACCOUNT] = this",
        "\t        and d.[DATE_PAY] < P_DATE)",
        "\tloop",
        "\t\tl_days := P_DATE - d.c_date;",
        "\t\t-- TODO: ставку пени брать из тарифа, пока константа",
        "\t\tl_sum := l_sum + d.c_sum * 0.001 * l_days;",
        "\t\tselect * in ::[DEBT_HIST] where [DEBT] = d.c_ref;",
        "\tend loop;",
        "",
        "\t[PENALTY_SUM] := l_sum;",
        "\tcommit;",
        "end;"
      ]
    },
